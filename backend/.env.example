# OpenRouter API key (https://openrouter.ai/keys). Never commit the real key.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# LiteLLM-style model id routed through OpenRouter.
# Free NVIDIA Nemotron model currently used by this project:
MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free

# Optional API server settings (defaults shown)
# API_HOST=127.0.0.1
# API_PORT=8000
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CREWAI_TRACING_ENABLED=false
